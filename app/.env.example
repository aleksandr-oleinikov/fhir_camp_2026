# Settings for the drug interaction routes (lib/ddi.js). Copy to .env and fill
# in; .env is ignored by git. This repository is public: never commit the real
# values.

# Root of the Aidbox instance, without /fhir
AIDBOX_URL=https://example.aidbox.app
# An Aidbox Client with the client_credentials grant
AIDBOX_CLIENT_ID=
AIDBOX_CLIENT_SECRET=
# Scholz DataBank customer key
SCHOLZ_UCI=
