<%- include('../partials/head', { signedIn: false, back: { href: '/connect', label: 'Choose a different data source' } }) %>

<% if (errors) { %>
  <div class="error-summary" role="alert" aria-labelledby="error-title" tabindex="-1">
    <h2 id="error-title">There is a problem</h2>
    <ul role="list">
      <% Object.entries(errors).forEach(([field, msg]) => { %>
        <li><a href="#<%= field %>"><%= msg %></a></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<%# Pill Sorter joined to the data source by a padlock. Decorative: the heading says it. %>
<div class="connect-hero" aria-hidden="true">
  <span class="connect-end connect-app"><%- include('../partials/app-icon') %></span>
  <span class="connect-line"></span>
  <span class="connect-lock">
    <svg viewBox="0 0 24 24" focusable="false"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="currentColor"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" fill="none" stroke="currentColor" stroke-width="2.2"/><circle cx="12" cy="15.5" r="1.6" fill="#fff"/></svg>
  </span>
  <span class="connect-line"></span>
  <span class="connect-end connect-source<%= payer.logoFill ? ' connect-fill' : '' %>"<% if (payer.logoBg) { %> style="background: <%= payer.logoBg %>"<% } %>>
    <img src="<%= asset(payer.logo) %>" alt="">
  </span>
</div>

<h1 class="center">Sign in to <%= payer.name %></h1>
<p class="lead center">Pill Sorter will read your medicines from <%= payer.name %><%= payer.detail ? ` (${payer.detail})` : '' %>.</p>

<form class="form-card" method="post" action="/connect/<%= payer.id %>" novalidate>
  <% [['username', 'Username', 'text'], ['password', 'Password', 'password']].forEach(([field, label, type]) => { %>
    <div class="field <%= errors && errors[field] ? 'field-error' : '' %>">
      <label for="<%= field %>"><%= label %></label>
      <% if (errors && errors[field]) { %>
        <p class="error-message" id="<%= field %>-error"><span class="visually-hidden">Error: </span><%= errors[field] %></p>
      <% } %>
      <input id="<%= field %>" name="<%= field %>" type="<%= type %>" autocomplete="off" spellcheck="false"
        <% if (field === 'username') { %>value="<%= values.username || '' %>"<% } %>
        <% if (errors && errors[field]) { %>aria-invalid="true" aria-describedby="<%= field %>-error"<% } %>>
    </div>
  <% }) %>
  <button class="button" type="submit">Sign in</button>
</form>
<p class="hint center">This is a demo: any username and password will work.</p>
<%- include('../partials/foot') %>
