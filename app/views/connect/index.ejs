<%- include('../partials/head', { signedIn: false }) %>

<% if (notice) { %>
  <div class="panel panel-success" role="status"><p><%= notice %></p></div>
<% } %>
<% if (resetError) { %>
  <div class="panel panel-important" role="alert"><p>We could not remove the medicines added during the demo from the test server. They may still show next time.</p></div>
<% } %>

<h1>Connect to data source</h1>
<p class="lead">Choose where your medicines and health records are kept.</p>

<ul class="payers" role="list">
  <% payers.forEach(p => { %>
    <li>
      <% if (p.patientId) { %>
        <a class="payer <%= p.logo ? 'payer-has-logo' : '' %> <%= p.logoFill ? 'payer-fill' : '' %>"<% if (p.logoBg) { %> style="background: <%= p.logoBg %>"<% } %> href="/connect/<%= p.id %>">
          <% if (p.logo) { %><img class="payer-logo" src="<%= asset(p.logo) %>" alt="<%= p.name %>"><% } else { %><span class="payer-name"><%= p.name %></span><% } %>
        </a>
      <% } else { %>
        <button class="payer <%= p.logo ? 'payer-has-logo' : '' %> <%= p.logoFill ? 'payer-fill' : '' %>"<% if (p.logoBg) { %> style="background: <%= p.logoBg %>"<% } %> type="button" aria-disabled="true">
          <% if (p.logo) { %><img class="payer-logo" src="<%= asset(p.logo) %>" alt="<%= p.name %>"><% } else { %><span class="payer-name"><%= p.name %></span><% } %>
          <span class="visually-hidden">(not available in this demo)</span>
        </button>
      <% } %>
    </li>
  <% }) %>
</ul>

<%# Not working in this demo. %>
<button class="button button-secondary" type="button" aria-disabled="true">
  <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
  Add data source<span class="visually-hidden"> (not available in this demo)</span>
</button>
<%- include('../partials/foot') %>
