<%- include('partials/head') %>
<h1>Hi <%= patientName %>!</h1>

<% if (loadError) { %>
  <div class="panel panel-important" role="alert">
    <h2>We could not reach your record</h2>
    <p>The list below may be out of date. Try "Update my list" in a moment.</p>
  </div>
<% } %>

<% if (notice) { %>
  <div class="panel panel-success" role="status"><p><%= notice %></p></div>
<% } %>

<% if (conflicts.length) { %>
  <h2 class="section-heading">
    <%= conflicts.length === 1 ? 'Some of your medicines may not mix well' : `${conflicts.length} pairs of your medicines may not mix well` %>
  </h2>
  <p>Tap the warning marks to find out what to do.</p>
  <% conflicts.forEach((c, i) => { %>
    <section class="conflict conflict-<%= c.severity %>" aria-labelledby="conflict-<%= i %>">
      <h3 class="conflict-heading" id="conflict-<%= i %>">
        <a class="conflict-open" href="/conflicts/<%= c.id %>">
          <%- include('partials/severity', { level: c.severity }) %>
          <span class="visually-hidden"><%= c.meds[0].medication %> and <%= c.meds[1].medication %> may not mix well.</span>
          <span class="conflict-advice"><%= c.severityInfo.advice %></span>
          <span class="conflict-chevron" aria-hidden="true">›</span>
        </a>
      </h3>
      <ul class="med-list" role="list">
        <% c.meds.forEach(m => { %><%- include('partials/med-row', { m }) %><% }) %>
      </ul>
    </section>
  <% }) %>
<% } %>

<% if (others.length) { %>
  <section aria-labelledby="others-heading">
    <h2 id="others-heading" class="section-heading"><%= conflicts.length ? 'Your other medicines' : 'Your medicines' %></h2>
    <ul class="med-list" role="list">
      <% others.forEach(m => { %><%- include('partials/med-row', { m }) %><% }) %>
    </ul>
  </section>
<% } %>

<div class="actions">
  <form method="post" action="/medicines/update">
    <button class="action-tile" type="submit">
      <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 0 1-14.3 4.9M4 12a8 8 0 0 1 14.3-4.9M18.5 3v4.2h-4.2M5.5 21v-4.2h4.2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Update my list
    </button>
  </form>
  <a class="action-tile action-tile-secondary" href="/medicines/add">
    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    Add a medicine
  </a>
</div>
<p class="updated-note">List last updated from your doctor's record <%= formatWhen(lastUpdated) %>.</p>

<% if (conflicts.length) { %>
  <section class="key" aria-labelledby="key-heading">
    <h2 id="key-heading">What the warning marks mean</h2>
    <dl>
      <% [3, 2, 1].forEach(level => { %>
        <div>
          <dt><%- include('partials/severity', { level }) %></dt>
          <dd><%= SEVERITY[level].advice %></dd>
        </div>
      <% }) %>
    </dl>
  </section>
<% } %>
<%- include('partials/foot') %>
