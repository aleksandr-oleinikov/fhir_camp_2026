<li>
  <a class="med-row" href="<%= typeof href !== 'undefined' ? href : '/medicines/' + m.id %>">
    <%- include('med-icon', { form: m.form }) %>
    <span class="med-body">
    <span class="med-name"><%= m.medication %></span>
    <span class="med-detail">
      <% if (m.reason) { %><span class="med-for"><%= m.reason %></span><% } %>
      <% if (m.source !== 'patient' && m.requester) { %><span class="med-from">From <%= m.requester %></span><% } %>
    </span>
    <% if (m.tags.length) { %>
      <span class="med-tags">
        <% m.tags.forEach(t => { %><span class="tag tag-<%= t.tone %>"><%= t.text %></span><% }) %>
      </span>
    <% } %>
    </span>
  </a>
</li>
