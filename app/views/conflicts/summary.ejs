<%- include('../partials/head') %>
<a class="round-back" href="/">
  <span class="round-back-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
  Back
</a>

<p class="summary-severity"><%- include('../partials/severity', { level: conflict.severity }) %></p>
<h1><%= conflict.meds[0].medication %> and <%= conflict.meds[1].medication %></h1>

<ul class="contact-list" role="list">
  <% conflict.meds.forEach(m => { %>
    <li class="contact-row">
      <span class="contact-med"><%= m.medication %></span>
      <% if (m.source === 'patient') { %>
        <span class="contact-who">Bought by you</span>
        <span class="contact-action contact-note">Ask any pharmacist</span>
      <% } else { %>
        <span class="contact-who"><%= m.requester || 'Your doctor' %></span>
        <a class="contact-action call" href="tel:<%= m.requesterPhone.replace(/\s/g, '') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" fill="currentColor"/></svg>
          <span>Call <%= m.requesterPhone %><span class="visually-hidden"> about <%= m.medication %></span></span>
        </a>
      <% } %>
    </li>
  <% }) %>
</ul>

<h2 class="description-heading">What this means</h2>
<p class="description"><%= conflict.summary %></p>
<%- include('../partials/foot') %>
