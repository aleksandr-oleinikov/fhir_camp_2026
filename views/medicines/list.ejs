<%- include('../partials/head', { back: { href: '/', label: 'Home' } }) %>
<h1>Medicines</h1>
<p class="lead">The medicines you take now.</p>

<ul class="list" role="list">
  <% medicines.forEach(m => { %>
    <li>
      <a class="list-item" href="/medicines/<%= m.id %>">
        <span class="list-title"><%= m.medication %></span>
        <span class="list-meta"><%= m.reason %></span>
        <% if (requested.has(m.id)) { %>
          <span class="tag tag-ok">Repeat requested</span>
        <% } else if (m.dueSoon) { %>
          <span class="tag tag-warn">Repeat due <%= formatDate(m.repeat.nextDue) %></span>
        <% } %>
      </a>
    </li>
  <% }) %>
</ul>
<%- include('../partials/foot') %>
