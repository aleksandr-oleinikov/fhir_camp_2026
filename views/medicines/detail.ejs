<%- include('../partials/head', { back: { href: '/medicines', label: 'All medicines' } }) %>

<% if (justRequested && requested) { %>
  <div class="panel panel-success" role="status">
    <h2>Repeat prescription requested</h2>
    <p>Your doctor's surgery will check your request. This usually takes 2 working days. Your pharmacy will let you know when it is ready.</p>
  </div>
<% } %>

<h1><%= med.medication %></h1>
<p class="lead"><%= med.strength %></p>

<dl class="facts">
  <div>
    <dt>What it is for</dt>
    <dd><%= med.reason %></dd>
  </div>
  <div>
    <dt>How to take it</dt>
    <dd><strong><%= med.dosageInstruction %></strong></dd>
  </div>
</dl>

<% if (med.warning) { %>
  <section class="panel panel-important" aria-labelledby="warn">
    <h2 id="warn">Important</h2>
    <p><%= med.warning %></p>
  </section>
<% } %>

<% if (med.repeat) { %>
  <h2>Repeat prescription</h2>
  <% if (requested) { %>
    <p>You have already asked for a repeat of this medicine.</p>
  <% } else { %>
    <p>Your next repeat is due <strong><%= formatDate(med.repeat.nextDue) %></strong>.
      You have <%= med.repeat.remaining %> <%= med.repeat.remaining === 1 ? 'repeat' : 'repeats' %> left before your doctor needs to review it.</p>
    <form method="post" action="/medicines/<%= med.id %>/repeat">
      <button class="button" type="submit">Request a repeat</button>
    </form>
  <% } %>
<% } else { %>
  <h2>Getting more</h2>
  <p>You can buy this medicine from a pharmacy or supermarket.</p>
<% } %>
<%- include('../partials/foot') %>
