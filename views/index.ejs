<%- include('partials/head') %>
<h1>Hi <%= patientName %>!</h1>

<% if (notice) { %>
  <div class="panel panel-success" role="status"><p><%= notice %></p></div>
<% } %>

<% if (attention.length) { %>
  <section class="attention" aria-labelledby="attention-heading">
    <h2 id="attention-heading">Needs your attention</h2>
    <ul class="med-list" role="list">
      <% attention.forEach(m => { %><%- include('partials/med-row', { m }) %><% }) %>
    </ul>
  </section>
<% } %>

<% if (others.length) { %>
  <section aria-labelledby="others-heading">
    <h2 id="others-heading"><%= attention.length ? 'Your other medicines' : 'Your medicines' %></h2>
    <ul class="med-list" role="list">
      <% others.forEach(m => { %><%- include('partials/med-row', { m }) %><% }) %>
    </ul>
  </section>
<% } %>

<div class="actions">
  <form method="post" action="/medicines/update">
    <button class="action-tile" type="submit">
      <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 0 1-14.3 4.9M4 12a8 8 0 0 1 14.3-4.9M18.5 3v4.2h-4.2M5.5 21v-4.2h4.2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Update my list
    </button>
  </form>
  <a class="action-tile action-tile-secondary" href="/medicines/add">
    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    Add a medicine
  </a>
</div>
<p class="updated-note">List last updated from your doctor's record <%= formatWhen(lastUpdated) %>.</p>
<%- include('partials/foot') %>
